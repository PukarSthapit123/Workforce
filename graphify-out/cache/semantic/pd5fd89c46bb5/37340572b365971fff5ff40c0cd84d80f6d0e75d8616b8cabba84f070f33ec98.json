{"nodes": [{"id": "docs_specs_2026_09_25_react_app_foundation_core_design_spec", "label": "Sub-project 1 design: Foundation and Workforce core", "file_type": "document", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rebuild Qnipay Workforce as React in stages against a fake API shaped like the real one, so application code does not change at the swap."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_v15_prototype", "label": "Qnipay v15 prototype (qnipay-workforce-v15.html)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Behavioural and visual reference implementation, read-only, at ../Qnipay workforce cc/mockup/."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_regression_suite", "label": "Prototype regression suite (qnipay-regression-suite.js, 965 assertions)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_sub_projects", "label": "Sub-projects 1-7 (Foundation, Timesheet, Rota, Leave, Onboarding, Payroll/BC, Production swap)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rota before Leave, as in PRD section 13. Each sub-project gets its own spec and plan."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_delivery_plans", "label": "Delivery plans 1a / 1b / 1c", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1a foundation and access; 1b people, dimensions, employee types, self-service; 1c configuration and communication. Audit and access come first because every later write depends on them."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_one_boundary", "label": "One boundary: features call api/ only, api/ speaks HTTP only", "file_type": "rationale", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MSW answers behind HTTP and can be switched off one endpoint at a time, enabling the production swap."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_rules_server_side", "label": "Rules live on the server side (handlers call domain/)", "file_type": "rationale", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Client never enforces a rule the server does not also enforce; client validation only repeats a server rule for fast feedback. UI reports success only from the response."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_msw_fake_server", "label": "MSW fake server with in-memory store", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisted to localStorage under a seed version; an older seed version is set aside, never half-loaded."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_dev_endpoints", "label": "/api/_dev endpoints (reset, seed, clock, faults)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Development and test endpoints excluded from production builds, used to reset, seed tenants, freeze the clock and inject faults."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_zod_contract", "label": "Zod contract and OpenAPI output", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single contract used by client, fake server and generated contract/openapi.json, the draft API spec for the production team. REST under /api/v1; state changes are explicit endpoints, never a PATCH of a state field."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_optimistic_concurrency", "label": "Optimistic concurrency (version, If-Match, 412)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every record carries id, version, updatedAt; writes send If-Match; stale gets 412, mirroring Business Central etags."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_refusal_shape", "label": "Refusal shape {code, message, next, usedBy?, field?}", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "403 capability, 409 in use or illegal transition, 412 stale, 422 validation. Toasts show message and next, enforcing the house rule that a refusal states consequence and what to do next."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_money_lint", "label": "No monetary fields / money lint", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema lint fails on fields named amount, price, salary, wage, grossPay, netPay, rateValue or currency symbols; exceptions go in contract/money-lint.allow.json with a reason."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_test_id_registry", "label": "Test ID registry (src/testids.ts, data-testid)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One typed registry shared by components and Playwright; format area-element[-recordId]; never contains display text so renaming a label never breaks a test; wrapped components require a testId prop."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_qp_tokens", "label": "--qp design tokens (ui/tokens.css)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-tier stylesheet lifted verbatim from the prototype including the dark theme; Tailwind theme maps to it so shadcn renders in Qnipay colours, Inter and the 4px grid."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_shadcn_radix", "label": "shadcn/ui on Radix", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches the Dogma HIG (itself shadcn/Radix); Radix supplies focus management, keyboard and ARIA."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_seed_extraction", "label": "Seed extraction from the prototype", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prototype keeps data in a closure, so a script loads it in jsdom, signs in and reads its localStorage store; no sample data is retyped. Output committed as src/mocks/seed/*.json for qnipay and social tenants."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_trace_json", "label": "Prototype trace (e2e/trace.json)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per prototype suite assertion with status ported / n/a / pending; ported tests keep the prototype's text; CI fails if a completed plan's row is pending."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_testing_layers", "label": "Testing layers (domain, contract, component, e2e)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vitest for domain and contract, Testing Library for components, Playwright Chromium for e2e, plus axe, 390px phone and visual baseline checks."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_e2e_rules", "label": "End-to-end test rules", "file_type": "rationale", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "beforeEach resets and freezes clock; read the record back after actions; refusal tests prove nothing changed; every mutation has a fault test; no fixed sleeps."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_per_user_exceptions", "label": "Per-user grants and revocations", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New relative to the prototype (which holds only emp/mgr/adm columns); built from the CLAUDE.md access model, read as 'Manager + 2 exceptions'; trace rows n/a (not in prototype)."}, {"id": "docs_specs_2026_09_25_react_app_foundation_core_design_audit_log", "label": "Audit log (iaudit)", "file_type": "concept", "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handler writes one audit row per state change: who, what, before -> after, and why where required."}], "edges": [{"source": "docs_specs_2026_09_25_react_app_foundation_core_design_trace_json", "target": "docs_specs_2026_09_25_react_app_foundation_core_design_regression_suite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_2026_09_25_react_app_foundation_core_design_spec", "target": "docs_specs_2026_09_25_react_app_foundation_core_design_v15_prototype", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_specs_2026_09_25_react_app_foundation_core_design_spec", "target": "docs_specs_2026_09_25_react_app_foundation_core_design_sub_projects", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/specs/2026-09-25-react-app-foundation-core-design.md", "source_location": null, "weight": 1.0}, {"source": 